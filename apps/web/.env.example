# SERVER ONLY — required; no NODE_ENV-based default.
# Copy to apps/web/.env.local for local development only.
APP_ENV=development

# SERVER ONLY — optional, inactive provider contracts; no SDK/client is initialized.
# Leave each entire group absent until needed. Partial/blank groups fail validation.
# The provider ENV must match APP_ENV exactly. Use dedicated resources per environment.
# SUPABASE_ENV=development
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# SUPABASE_SERVICE_ROLE_KEY=<server-administration-key>
# CLOUDINARY_ENV=development
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<api-key>
# CLOUDINARY_API_SECRET=<api-secret>

# PUBLIC / BROWSER SAFE — none used; all NEXT_PUBLIC_* / EXPO_PUBLIC_* rejected.
# Potential future public Supabase identifiers require a reviewed allowlist first.
# OPERATIONS ONLY — DB migration/backup credentials, R2/monitoring/signing keys and
# decryption identities do not belong in this application's environment or template.
# See ../../docs/ENVIRONMENT.md for setup, trust boundaries and remaining limits.
