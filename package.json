{
  "name": "transport-manager",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm run dev --workspace=@transport-manager/web",
    "build": "npm run build --workspace=@transport-manager/web",
    "start": "npm run start --workspace=@transport-manager/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "prettier": "^3.6.2",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  }
}
